# -----------------------------------------------------------------------------
# Forwarders
# -----------------------------------------------------------------------------
[splunktcp://{{ splunk_port }}]
disabled = 0

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------

[monitor:///tmp/test.log]
index = linux
sourcetype = test
crcSalt = <SOURCE>

# -----------------------------------------------------------------------------
# System, Kernel, & Package Management
# -----------------------------------------------------------------------------

[monitor:///var/log/auth.log]
index = linux
sourcetype = linux_secure
crcSalt = <SOURCE>
blacklist = \.(gz|bz2|zip)$|\.\d$
 
[monitor:///var/log/secure]
index = linux
sourcetype = linux_secure
crcSalt = <SOURCE>
blacklist = \.(gz|bz2|zip)$|\.\d$
 
[monitor:///var/log/messages]
index = linux
sourcetype = syslog
crcSalt = <SOURCE>
blacklist = \.(gz|bz2|zip)$|\.\d$
 
[monitor:///var/log/syslog]
index = linux
sourcetype = syslog
crcSalt = <SOURCE>
blacklist = \.(gz|bz2|zip)$|\.\d$
 
[monitor:///var/log/kern.log]
index = linux
sourcetype = linux_kernel
crcSalt = <SOURCE>
blacklist = \.(gz|bz2|zip)$|\.\d$
 
[monitor:///var/log/cron]
index = linux
sourcetype = cron
crcSalt = <SOURCE>
blacklist = \.(gz|bz2|zip)$|\.\d$
 
[monitor:///var/log/yum.log]
index = linux
sourcetype = package
crcSalt = <SOURCE>
 
[monitor:///var/log/apt/history.log]
index = linux
sourcetype = package
crcSalt = <SOURCE>

# -----------------------------------------------------------------------------
# Security Services (Audit, Firewall, IDS, etc.)
# -----------------------------------------------------------------------------
 
[monitor:///var/log/audit/audit.log]
index = linux
sourcetype = linux:audit
crcSalt = <SOURCE>
blacklist = \.(gz|bz2|zip)$|\.\d$

[monitor:///var/log/ufw.log]
index = linux
sourcetype = linux:ufw
crcSalt = <SOURCE>
blacklist = \.(gz|bz2|zip)$|\.\d$

[monitor:///var/log/firewalld]
index = linux
sourcetype = linux:firewalld
crcSalt = <SOURCE>

# -----------------------------------------------------------------------------
# Scored Services
# -----------------------------------------------------------------------------

[monitor:///opt/splunk/var/log/splunk/audit.log]
index = services
sourcetype = audittrail
crcSalt = <SOURCE>

[monitor:///opt/splunk/var/log/splunk/splunkd_ui_access.log]
index = services
sourcetype = splunkd_ui_access
crcSalt = <SOURCE>
